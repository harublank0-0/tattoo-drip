# Settings of the storefront (the studio pages). Copy to
# /srv/tattoo-drip/env/storefront.env (mode 600). Replace every CHANGE_ME.
# It refuses to serve a page on a missing or malformed value, and names it.

# Production mode: makes the server key and the Turnstile site key required.
NODE_ENV=production
# The platform's public https origin, as the storefront's server and the visitors' browsers reach it; the platform's APP_URL.
API_URL=https://tattoodrip.app
# The origin the studios' photos are served from: the platform's R2_PUBLIC_URL. The pages show photos from this origin only.
MEDIA_URL=https://media.tattoodrip.app
# The studio pages' origin with {tenant} for the slug; the same value as the platform's STOREFRONT_URL.
STOREFRONT_URL=https://{tenant}.tattoodrip.page
# The storefront's key for its server-side API calls: one of the platform's STOREFRONT_SERVER_KEYS; openssl rand -hex 32.
STOREFRONT_SERVER_KEY=CHANGE_ME
# Public site key of the studio pages' Turnstile widget (it is sent to every visitor).
TURNSTILE_SITE_KEY=CHANGE_ME
# Optional: Sentry DSN for server-side errors; leave it commented out to run without Sentry.
# VITE_SENTRY_DSN=
