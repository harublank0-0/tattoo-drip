# Settings of the Postgres container, read once when it creates an empty data
# volume (changing them later does not change an existing database). Copy to
# /srv/tattoo-drip/env/postgres.env (mode 600). Replace every CHANGE_ME.

# The owner role (superuser); it runs migrations and backups.
POSTGRES_USER=postgres
# The owner's password: openssl rand -hex 32. The same as DB_MIGRATION_PASSWORD in migrate.env and PGPASSWORD in backup.env.
POSTGRES_PASSWORD=CHANGE_ME
# The database to create; the same as DB_DATABASE in platform.env.
POSTGRES_DB=tattoo_drip
# The restricted app role the init scripts create; the same as DB_USER in platform.env.
APP_DB_USER=tattoo_drip_app
# The app role's password: openssl rand -hex 32. The same as DB_PASSWORD in platform.env.
APP_DB_PASSWORD=CHANGE_ME
