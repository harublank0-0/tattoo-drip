# Settings of the nightly backup job (compose profile "tools", Task 5's backup
# service). Copy to /srv/tattoo-drip/env/backup.env (mode 600). Replace every
# CHANGE_ME. The job dumps the database as the owner and copies the dump to the
# private "backups" bucket with a token that reaches that bucket only.

# Postgres host: the compose service name.
PGHOST=postgres
# The owner role; the same as POSTGRES_USER in postgres.env.
PGUSER=postgres
# The owner's password; the same as POSTGRES_PASSWORD in postgres.env.
PGPASSWORD=CHANGE_ME
# The database to dump; the same as POSTGRES_DB in postgres.env.
PGDATABASE=tattoo_drip
# Where dumps go: an rclone path on the "r2" remote defined below (bucket, then folder).
BACKUP_DEST=r2:tattoo-drip-backups/db
# How many days of dumps to keep.
BACKUP_KEEP_DAYS=30
# The rclone remote "r2" is an S3-compatible store.
RCLONE_CONFIG_R2_TYPE=s3
# The S3 provider behind it: Cloudflare R2.
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# Access key ID of the R2 API token for the backups bucket only.
RCLONE_CONFIG_R2_ACCESS_KEY_ID=CHANGE_ME
# Secret access key of that token.
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=CHANGE_ME
# R2's S3 endpoint: https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
# Optional: a healthchecks.io ping URL, pinged after each successful backup; leave it commented out to skip the ping.
# HEARTBEAT_URL=https://hc-ping.com/CHANGE_ME
