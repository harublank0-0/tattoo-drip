# Extra settings of the migrate step only (compose profile "tools"), read after
# platform.env. Web and worker never get the owner's password; only this step,
# postgres.env (which sets it) and backup.env (the nightly dump) hold it.
# Copy to /srv/tattoo-drip/env/migrate.env (mode 600).

# The owner role's password; the same as POSTGRES_PASSWORD in postgres.env.
DB_MIGRATION_PASSWORD=CHANGE_ME
