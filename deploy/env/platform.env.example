# Settings of the platform's web server, its worker and every one-off command
# (migrate too), so all three read the same file. Copy to
# /srv/tattoo-drip/env/platform.env (mode 600). Replace every CHANGE_ME; nothing
# else needs to change. Plain KEY=value lines: no quotes, no spaces around =.
# Every platform process runs the production checks in start/env.ts and
# refuses to start on a missing or malformed value.

# Production mode: turns on the checks that require the settings below.
NODE_ENV=production
# Time zone of the process; timestamps are stored in UTC either way.
TZ=UTC
# Address the web server listens on inside the container (nginx reaches it here).
HOST=0.0.0.0
# Port the web server listens on; nginx and the healthcheck use 3333.
PORT=3333
# Log level of the app (info is enough; debug is noisy and may hold personal data).
LOG_LEVEL=info

# Secret key for sessions, cookies and deposit links: openssl rand -hex 32, 64 hex characters (deploy/README.md). Changing it signs everyone out.
APP_KEY=CHANGE_ME
# The dashboard's and API's public https origin, on a different domain from the studio pages.
# Account, invitation and alert emails link here. D11 cutover: https://app.tattoodrip.app
# (docs/discover/domain-migration.md).
APP_URL=https://tattoodrip.app
# The API's own origin once it moves off APP_URL's host; that host then serves /api only.
# Leave unset until the D11 cutover, then: API_URL=https://api.tattoodrip.app
# API_URL=
# Discover's origin: an allowed browser origin of the API, never APP_URL's or API_URL's host.
# Leave unset until Discover is deployed at the D11 cutover, then: DISCOVER_URL=https://tattoodrip.app
# DISCOVER_URL=
# The studio pages' origin with {tenant} for the studio's slug; the same value as the storefront's.
STOREFRONT_URL=https://{tenant}.tattoodrip.page
# The storefront's key (storefront.env: STOREFRONT_SERVER_KEY): openssl rand -hex 32. Two separated by a comma while rotating (old,new).
STOREFRONT_SERVER_KEYS=CHANGE_ME
# The reverse proxy whose X-Forwarded-For is believed: nginx's fixed address in deploy/compose.yml. Never a wider range.
TRUST_PROXY=172.30.42.10
# Secret key of the studio pages' Turnstile widget (Cloudflare dashboard, Turnstile).
TURNSTILE_SECRET_KEY=CHANGE_ME
# Where the dashboard keeps its session: in the cookie.
SESSION_DRIVER=cookie

# Postgres host: the compose service name.
DB_HOST=postgres
# Postgres port inside the compose network.
DB_PORT=5432
# Database name; the same as POSTGRES_DB in postgres.env.
DB_DATABASE=tattoo_drip
# The restricted app role; the same as APP_DB_USER in postgres.env.
DB_USER=tattoo_drip_app
# The app role's password; the same as APP_DB_PASSWORD in postgres.env: openssl rand -hex 32.
DB_PASSWORD=CHANGE_ME
# Name of the owner role that runs migrations (its password is only in migrate.env).
DB_MIGRATION_USER=postgres

# Cloudflare account ID: 32 lowercase hex characters (Cloudflare dashboard, R2 overview).
R2_ACCOUNT_ID=CHANGE_ME
# Access key ID of the R2 API token with read and write on the two image buckets.
R2_ACCESS_KEY_ID=CHANGE_ME
# Secret access key of that token (shown once, when the token is created).
R2_SECRET_ACCESS_KEY=CHANGE_ME
# Bucket for public images (portfolio, flash, logos), served at R2_PUBLIC_URL.
R2_PUBLIC_BUCKET=tattoo-drip-public
# Bucket for private images (reference photos, payment screenshots); no public access.
R2_PRIVATE_BUCKET=tattoo-drip-private
# The public bucket's custom domain: an https origin with no path.
R2_PUBLIC_URL=https://media.tattoodrip.app

# Mail transport; smtp is the only one.
MAIL_MAILER=smtp
# Sender name in emails.
MAIL_FROM_NAME=Tattoo Drip
# Sender address; placeholder until the sending domain has SPF, DKIM and DMARC (TAT-20).
MAIL_FROM_ADDRESS=no-reply@tattoodrip.app
# SMTP provider's host; placeholder until TAT-20.
SMTP_HOST=smtp.example.com
# SMTP provider's port (587 or 465); placeholder until TAT-20.
SMTP_PORT=587
# SMTP login; empty until TAT-20.
SMTP_USERNAME=
# SMTP password; empty until TAT-20.
SMTP_PASSWORD=
# false keeps staff alerts in the dashboard only, until mail works (TAT-20).
ALERT_EMAILS=false
