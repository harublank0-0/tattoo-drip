# Settings of Discover (tattoodrip.app, D05; docs/discover/frontend.md). Copy to
# /srv/tattoo-drip/env/discover.env (mode 600) when Discover is deployed (D11).
# It refuses to serve a page on a missing or malformed value, and names it.
NODE_ENV=production
# The platform API's public https origin. D11: https://api.tattoodrip.app
API_URL=https://api.tattoodrip.app
# The origin public photos are served from: the platform's R2_PUBLIC_URL.
MEDIA_URL=https://media.tattoodrip.app
# Discover's own origin, the same value as the platform's DISCOVER_URL.
DISCOVER_URL=https://tattoodrip.app
# Studio OS's origin (the platform's APP_URL after the cutover): Sign in and Get started.
APP_URL=https://app.tattoodrip.app
# "on" only on the launched production site, after the business decision (blueprint J).
DISCOVER_INDEXING=off
# The countries Discover lists first (ISO codes, comma-separated) and the default
# for a visitor with no saved choice (one of them; unset: the first). D06.5.
DISCOVER_MARKETS=NP
DISCOVER_DEFAULT_COUNTRY=NP
# Geolocation: the header nginx sets from Cloudflare's country, only for requests
# from cloudflared (deploy/nginx/hosts.split.conf). Off until D11 has checked
# that Cloudflare overwrites a visitor's own CF-IPCountry and that Discover's
# port is reachable only through nginx; then: DISCOVER_GEO_HEADER=X-Discover-Country
DISCOVER_GEO_HEADER=
