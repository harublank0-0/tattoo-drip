SESSION_DRIVER=memory
STOREFRONT_URL=http://{tenant}.localhost:3000
# The split hosts (Discover D01): the API's own host and Discover's serve /api
# only, and Discover is an allowed browser origin. The tests reach the app on
# localhost, so they answer as before unless a test names one of these hosts.
API_URL=http://api.localhost:3333
DISCOVER_URL=http://discover.localhost:3002
# Never inherit a developer's .env Turnstile secret: the bot challenge stays off
# in tests unless a test turns it on (tests/helpers/challenge.ts).
# A value exported in the shell or a CI job's environment still wins over this
# empty one, and the tests that expect the check off then fail loudly.
TURNSTILE_SECRET_KEY=
# Two server keys (TAT-38), sent by the HTTP tests as the storefront would.
STOREFRONT_SERVER_KEYS=test-key-one-0123456789abcdefghijklmnopqrstuv,test-key-two-0123456789abcdefghijklmnopqrstuv
# Staff alert emails on (TAT-52): tests queue them on the fake or in the
# test's transaction and never send real mail. A developer's
# ALERT_EMAILS=false must not turn them off here.
ALERT_EMAILS=true
# Tests always use the local photo folders (TAT-27): a developer's R2 values in .env never reach real buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
