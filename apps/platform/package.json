{
	"name": "@tattoo-drip/platform",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"start": "node bin/server.js",
		"build": "node ace build",
		"dev": "node ace serve --hmr",
		"worker": "node ace queue:work",
		"test": "node ace test",
		"typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json"
	},
	"imports": {
		"#controllers/*": "./app/controllers/*.js",
		"#exceptions/*": "./app/exceptions/*.js",
		"#models/*": "./app/models/*.js",
		"#mails/*": "./app/mails/*.js",
		"#services/*": "./app/services/*.js",
		"#modules/*": "./app/modules/*.js",
		"#listeners/*": "./app/listeners/*.js",
		"#events/*": "./app/events/*.js",
		"#generated/*": "./.adonisjs/server/*.js",
		"#middleware/*": "./app/middleware/*.js",
		"#transformers/*": "./app/transformers/*.js",
		"#validators/*": "./app/validators/*.js",
		"#providers/*": "./providers/*.js",
		"#policies/*": "./app/policies/*.js",
		"#abilities/*": "./app/abilities/*.js",
		"#database/*": "./database/*.js",
		"#tests/*": "./tests/*.js",
		"#start/*": "./start/*.js",
		"#config/*": "./config/*.js",
		"#jobs/*": "./app/jobs/*.js"
	},
	"devDependencies": {
		"@adonisjs/assembler": "^8.5.2",
		"@adonisjs/tsconfig": "^2.0.0",
		"@japa/api-client": "^3.2.1",
		"@japa/assert": "^4.2.0",
		"@japa/browser-client": "^2.3.0",
		"@japa/plugin-adonisjs": "^5.2.0",
		"@japa/runner": "^5.3.0",
		"@poppinss/ts-exec": "^1.4.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/luxon": "^3.7.5",
		"@types/node": "~26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"hot-hook": "^1.0.0",
		"pino-pretty": "^13.1.3",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.0",
		"youch": "^4.1.1"
	},
	"dependencies": {
		"@adonisjs/auth": "^10.1.0",
		"@adonisjs/core": "^7.5.2",
		"@adonisjs/cors": "^3.0.0",
		"@adonisjs/inertia": "^5.0.1",
		"@adonisjs/lucid": "^22.4.2",
		"@adonisjs/mail": "^10.4.0",
		"@adonisjs/queue": "0.6.2",
		"@adonisjs/session": "^8.1.0",
		"@adonisjs/shield": "^9.0.0",
		"@adonisjs/static": "^2.0.1",
		"@adonisjs/vite": "^6.0.2",
		"@boringnode/queue": "0.6.0",
		"@inertiajs/core": "^3.7.1",
		"@inertiajs/react": "^3.7.1",
		"@tuyau/core": "^1.2.2",
		"@vinejs/vine": "^4.4.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"edge.js": "^6.5.1",
		"lucide-react": "^1.48.0",
		"luxon": "^3.7.2",
		"pg": "^8.16.3",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"reflect-metadata": "^0.2.2",
		"sonner": "^2.0.8"
	},
	"hotHook": {
		"boundaries": [
			"./app/controllers/**/*.ts",
			"./app/middleware/*.ts"
		]
	}
}
