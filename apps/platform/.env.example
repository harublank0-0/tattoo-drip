# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
# The dashboard's and API's public origin. With NODE_ENV=production it must be
# https and on a domain of its own, apart from STOREFRONT_URL's (e.g.
# https://app.example.com with studio pages on
# https://{tenant}.example-studios.com): the app refuses to start otherwise.
APP_URL=http://${HOST}:${PORT}
# The studio pages' origin, with {tenant} where the slug goes. Deposit links
# are built from it (TAT-65). REQUIRED when NODE_ENV=production (the app
# refuses to start without it). Unset in development and tests it is
# http://{tenant}.localhost:3000, and the project page warns that no client
# can open such a link.
# STOREFRONT_URL=https://{tenant}.example.com
# The storefront server's key (TAT-38): the same value as the storefront's
# STOREFRONT_SERVER_KEY, so its server-side API calls count per visitor
# instead of as one client. It grants no data. One key, or two separated by
# a comma while you rotate (old,new); each 32 to 256 letters, digits or
# -._~+/ characters, then at most two = (openssl rand -base64 32).
# REQUIRED when NODE_ENV=production; unset in development, no key is accepted.
# STOREFRONT_SERVER_KEYS=

# The reverse proxy in front of the app, whose X-Forwarded-For it believes
# (TAT-38): loopback, linklocal, uniquelocal, IP addresses or CIDR ranges,
# comma-separated, e.g. loopback, 10.0.0.0/8; never every address.
# REQUIRED when NODE_ENV=production; unset, only loopback is trusted.
# TRUST_PROXY=
# The secret key of the studio pages' Cloudflare Turnstile widget (the
# intake form's bot challenge, TAT-55): Cloudflare dashboard, Turnstile, the
# widget's settings. REQUIRED when NODE_ENV=production (the app refuses to
# start without it). Unset in development, the check is off and any inquiry
# passes it.
# TURNSTILE_SECRET_KEY=

# Session
SESSION_DRIVER=cookie

# Database (defaults match the root docker-compose.yml)
# DB_USER is the restricted app role that database/setup_roles.sql creates.
# DB_MIGRATION_USER owns the tables and runs migrations (pnpm migrate).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tattoo_drip_app
DB_PASSWORD=tattoo_drip_app
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=postgres
DB_DATABASE=tattoo_drip

# Mail (defaults point at Mailpit from the root docker-compose.yml; its inbox
# is at http://localhost:8025). In production, set SMTP_* to the provider's
# SMTP endpoint (port 587 or 465), and MAIL_FROM_ADDRESS to the platform's domain.
MAIL_MAILER=smtp
MAIL_FROM_NAME=Tattoo Drip
MAIL_FROM_ADDRESS=no-reply@tattoo-drip.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
