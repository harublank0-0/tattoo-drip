@email.layout({ title: held ? 'Online payment to check' : 'Deposit paid online', preheader: held ? 'An online payment was held for review.' : 'A deposit was paid online and recorded.' })
  <p style="margin: 0 0 16px;">Hi {{ recipientName || 'there' }},</p>
  <p style="margin: 0 0 16px;">{{ intro }}</p>
  @if(held)
    <p style="margin: 0 0 16px;">Check it on the Transactions page and in your PayBridgeNP dashboard. If the client paid by mistake, refund it in PayBridgeNP.</p>
    @!email.button({ href: url, text: 'Open Transactions' })
  @else
    <p style="margin: 0 0 16px;">It's recorded on the project's Payments card. Nothing to check.</p>
    @!email.button({ href: url, text: 'Open the project' })
  @end
  <p style="margin: 0; font-size: 14px; line-height: 20px; color: #71717a;">
    You get these emails as a member of {{ studioName }} on Tattoo Drip.
  </p>
@end
