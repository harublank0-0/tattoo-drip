{
	"name": "@tattoo-drip/discover",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "dotenv -e .env.local -- sh -c \"PORT=3100 vite dev --port 3100\"",
		"generate-routes": "tsr generate",
		"build": "vite build && node scripts/check-client-bundle.mjs",
		"check:bundle": "node scripts/check-client-bundle.mjs",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
		"start": "node .output/server/index.mjs"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.60",
		"@tattoo-drip/react": "workspace:*",
		"@tattoo-drip/sdk": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv-cli": "^11.0.0",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"radix-ui": "^1.6.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6"
	},
	"devDependencies": {
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	}
}
