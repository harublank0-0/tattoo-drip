# Discover's settings (docs/discover/frontend.md). Copy to .env.local for
# `pnpm dev`; in production they come from the container's env file.

# The platform API's origin (no path); the SDK appends /api/v1.
API_URL=http://localhost:3333
# Optional: where public photos are served from. Unset: the API's origin.
# MEDIA_URL=
# Discover's own public origin: canonical and social URLs. The platform's
# DISCOVER_URL must be the same value, so its CORS allows the browser's calls.
DISCOVER_URL=http://localhost:3100
# Studio OS's origin (the platform's APP_URL): Sign in and Get started.
APP_URL=http://localhost:3333
# "on" lets search engines index Discover. Leave it off everywhere but the
# launched production site.
DISCOVER_INDEXING=off
# Country-aware discovery (D06.5, docs/discover/frontend.md, "Country").
# The countries Discover is local-first for (ISO codes, comma-separated) and
# the one a visitor without a preference gets (one of them; unset: the first).
DISCOVER_MARKETS=NP
# DISCOVER_DEFAULT_COUNTRY=NP
# The header a trusted proxy sets to the visitor's country; unset turns
# geolocation off. To try it locally: DISCOVER_GEO_HEADER=X-Discover-Country,
# then send that header yourself (curl -H 'X-Discover-Country: IN').
# DISCOVER_GEO_HEADER=
# How long the server keeps a built sitemap (seconds, 0-3600; 0: off; unset: 600).
# DISCOVER_SITEMAP_CACHE_SECONDS=600
