# Tattoo Drip API origin: the platform's address (its PORT, 3333 by default).
API_URL=http://localhost:3333

# The studio pages' origin, {tenant} where the slug goes: the same value as
# the platform's STOREFRONT_URL. In development, open http://<slug>.localhost:3000
# for a studio in the platform's database; http://localhost:3000 is the landing page.
STOREFRONT_URL=http://{tenant}.localhost:3000

# Secret key the storefront's server sends with its API calls
# (Authorization: Bearer), for rate limiting only. Optional until the
# platform checks it (TAT-38). When set it must be 32 to 256 letters, digits
# or -._~+/ characters, then at most two = of padding. Never give it a VITE_
# prefix: it must never reach a browser. Make one with: openssl rand -base64 32
# STOREFRONT_SERVER_KEY=

# Your Sentry DSN (from your Sentry account)
VITE_SENTRY_DSN=

# Your Sentry organization (from your Sentry account)
VITE_SENTRY_ORG=

# Your Sentry project (from your Sentry account)
VITE_SENTRY_PROJECT=

# Your Sentry authentication token (from your Sentry account)
SENTRY_AUTH_TOKEN=

# Add your Anthropic API key
ANTHROPIC_API_KEY=

# Postgres DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Mailpit configuration
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Redis configuration
REDIS_PORT=6379
