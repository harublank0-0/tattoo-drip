{
	"name": "@tattoo-drip/storefront",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
		"generate-routes": "tsr generate",
		"build": "vite build && cp instrument.server.mjs .output/server && node scripts/check-client-bundle.mjs",
		"check:bundle": "node scripts/check-client-bundle.mjs",
		"check:page": "node scripts/check-page.mjs",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test \"test/**/*.test.ts\"",
		"start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs"
	},
	"dependencies": {
		"@sentry/tanstackstart-react": "^10.67.0",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-query-devtools": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.60",
		"@tattoo-drip/react": "workspace:*",
		"@tattoo-drip/sdk": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.4.0",
		"dotenv-cli": "^11.0.0",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"radix-ui": "^1.6.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv-cli": "^11.0.0",
		"tsx": "^4.23.12",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	}
}
