model AtristProfile{
	id string @id default(cuid())

	userId String @unique

	slug String @unique

	displayName String

	bio String?

	city String

	countryCode String @db.VarChar(2)
	
	acceptingRequest Boolean @defualt(false)

	createdAt DateTime @default(now) @db.Timestapmtz(3)

	user User @relation(
	fields: [userId],
	references: [id]
	onDelete: Restrict
	)

	@@index[countryCode, city, acceptingRequests]

	@@map("artist_profile")
} 
