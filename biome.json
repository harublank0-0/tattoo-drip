{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!**/styles.css",
			"!**/src/generated",
			"!**/.adonisjs",
			"!**/inertia/css",
			"!**/openapi.gen.ts",
			"!**/.agents",
			"!**/skills-lock.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": [
				"apps/platform/app/**",
				"!apps/platform/app/services/db_context.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@adonisjs/lucid/services/db": "A query through the db service runs on a second pooled connection in production, outside the request transaction and its tenant settings (tests will not show it: the request is a savepoint on the test's one connection). Use a model, dbClient() or withTransaction() from #services/db_context."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/components/ui/**"],
			"linter": {
				"rules": {
					"a11y": { "useSemanticElements": "off" },
					"suspicious": { "noArrayIndexKey": "off", "noDoubleEquals": "off" }
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
