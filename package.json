{
	"name": "tattoo-drip",
	"private": true,
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "pnpm --parallel --filter \"./apps/*\" dev",
		"dev:platform": "pnpm --filter @tattoo-drip/platform dev",
		"dev:storefront": "pnpm --filter @tattoo-drip/storefront dev",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r --if-present test",
		"format": "biome format",
		"format:fix": "biome format --write",
		"lint": "biome lint",
		"check": "biome check",
		"prepare": "husky",
		"podman:up": "PODMAN_COMPOSE_PROVIDER=podman-compose podman compose up -d"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"only-allow": "^1.2.2",
		"typescript": "^6.0.2"
	},
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": "24.3.0",
		"pnpm": "12.8.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	}
}
