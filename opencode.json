{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode/deepseek-v4.1-flash-free",
	"instructions": [
		"apps/platform/AGENTS.md",
		"apps/storefront/AGENTS.md",
		"docs/agent-environment.md"
	],
	"permission": {
		"bash": {
			"*": "allow",
			"git push*": "deny",
			"git worktree*": "deny",
