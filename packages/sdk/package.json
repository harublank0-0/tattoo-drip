{
	"name": "@tattoo-drip/sdk",
	"version": "0.0.0",
	"description": "Framework-independent TypeScript client for the Tattoo Drip public API",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tattoo-drip/types": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^6.0.2"
	}
}
